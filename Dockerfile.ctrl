# Toolchain image for running Shannon fully in Docker — no Node/pnpm on the host.
#
# Contains Node 22 + pnpm + git + the docker CLI (with the compose & buildx plugins).
# The Shannon repo is NOT baked in; it is bind-mounted at its real host path at runtime
# and compiled in place, and the docker socket is mounted so the CLI can build/spawn the
# worker containers on the host daemon (paths line up because the data root is mounted 1:1).
FROM docker:27-cli AS dockercli

FROM node:22-bookworm-slim
COPY --from=dockercli /usr/local/bin/docker /usr/local/bin/docker
# docker CLI plugins: `docker compose` (starts Temporal) and `docker buildx` (image builds)
COPY --from=docker/compose-bin:latest /docker-compose /usr/local/lib/docker/cli-plugins/docker-compose
COPY --from=docker/buildx-bin:latest  /buildx        /usr/local/lib/docker/cli-plugins/docker-buildx
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && corepack enable
WORKDIR /app
CMD ["bash"]
