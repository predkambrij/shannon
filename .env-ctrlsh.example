# Config & secrets for ctrl.sh. Copy to .env-ctrlsh and fill in real values.
# .env-ctrlsh is gitignored; this template is safe to commit.

# ── Host layout ───────────────────────────────────────────────────────────────
# Set local DATA_ROOT in each scan target in ctrl.local.sh.
# Toolchain cache and Pi login stay in the Shannon repo’s .shannon-ctrl-home/.

# Host Docker socket mounted into the toolchain container.
DOCKER_SOCKET_PATH="/var/run/docker.sock"

# ── AI provider: choose one block ─────────────────────────────────────────────

# Option A: ChatGPT Plus/Pro subscription through OpenAI Codex (no API key).
# After `./ctrl.sh build`, run `./ctrl.sh chatgpt_login` once.
SHANNON_USE_PI_AUTH=1
SHANNON_AI_MODEL="openai-codex:gpt-6.1-sol"
# SHANNON_AI_MODEL="openai-codex:gpt-daybreak-blue-latest"

# Option B: z.ai (GLM) through its Anthropic-compatible endpoint.
# Comment out Option A, then uncomment and fill this block.
# SHANNON_USE_PI_AUTH=0
# SHANNON_AI_BASE_URL="https://api.z.ai/api/anthropic"
# SHANNON_AI_API_KEY="your-zai-api-key-here"
# SHANNON_AI_MODEL="anthropic:glm-5.3-flash"
