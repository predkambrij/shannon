# Config & secrets for ctrl.sh. Copy to .env-ctrlsh and fill in real values.
# .env-ctrlsh is gitignored; this template is safe to commit.

# ── Host layout ───────────────────────────────────────────────────────────────
# Absolute host dir holding this repo + every scan target. Mounted 1:1 into Docker
# so the worker sibling-containers get valid paths.
DATA_ROOT="/absolute/path/to/data-root"

# ── z.ai (GLM) via the Anthropic-compatible endpoint ──────────────────────────
ZAI_BASE_URL="https://api.z.ai/api/anthropic"
ZAI_API_KEY="your-zai-api-key-here"

# ── Model id per Shannon tier (passed through to the worker) ──────────────────
ANTHROPIC_SMALL_MODEL="GLM-4.5-Air"
ANTHROPIC_MEDIUM_MODEL="glm-4.7"
ANTHROPIC_LARGE_MODEL="glm-5"
